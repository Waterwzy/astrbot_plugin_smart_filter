{
    "filter_config" : {
        "description" : "审核模型（第一个llm）相关的配置",
        "type" : "object",
        "items" : {
            "filter_prompt" : {
                "description" : "审核提示词",
                "hint" : "审核的pormpt，需要在人格中添加，可参见readme并根据自身需要酌情修改",
                "type" : "string",
                "_special" : "select_persona"
            },
            "filter_provider" : {
                "description" : "审核模型提供商",
                "hint" : "建议使用有thinking功能的模型以获得最好效果",
                "type" : "string",
                "_special" : "select_provider"
            },
            "filter_allow" : {
                "description" : "审核通过关键词",
                "hint" : "通过审核后模型的预期输出，如果没有改动审核提示词不要改动此项",
                "type" : "string",
                "default" : "allow"
            },
            "filter_block" : {
                "description" : "审核未通过关键词",
                "hint" : "未通过审核后模型的预期输出，如果没有改动审核提示词不要改动此项",
                "type" : "string",
                "default" : "block"
            },
            "filter_roles" : {
                "description" : "多轮审核的对话轮数",
                "hint" : "本插件不保留模型输出的内容，仅将最近若干轮用户输入传递给审核模型，有助于审核模型了解上下文提升审核准确性，但是数值过大可能导致额外tokens消耗，不希望开启这个功能可设置为0",
                "type" : "int"
            },
            "filter_group" : {
                "description" : "是否对群聊消息开启审核",
                "hint" : "关闭后，群聊消息不会经过审核，根据自身需求进行配置",
                "type" : "bool",
                "default" : true
            },
            "filter_mode" : {
                "description" : "是否开启严格模式",
                "hint" : "严格模式：输出不含通过关键词就拒绝回复；非严格模式：输出含未通过关键词才拒绝回复",
                "type" : "bool"
            },
            "filter_failclose" : {
                "description" : "审核失败是否开启fail-close策略",
                "hint" : "在审核模型回复失败时，开启本配置项意味着默认拦截所有请求；如果您的业务不允许任何违规请求，请开启本配置项但尽可能保证你的审核模型随时可用。",
                "type" : "bool"
            },
            "debug_mode" : {
                "description" : "是否开启debug模式",
                "hint" : "debug模式：在利用违禁对话人设发送消息后发送一条审核模型返回的原始数据，可用于优化提示词（不适用于生产环境）",
                "type" : "bool"
            },
            "skip_empty_mode" : {
                "description" : "是否对空消息进行审核",
                "hint" : "关闭此选项对空消息不会触发审核，可以节省tokens使用量，建议关闭",
                "type" : "bool"
            },
            "skip_schema" : {
                "type" : "template_list",
                "description" : "特定消息跳过配置",
                "hint" : "针对特殊消息内容的跳过处理，用于屏蔽部分以user字段发送的系统消息（例如AstrBot的定时任务消息）。存在被绕过的风险，请谨慎评估后使用（如果必须使用，推荐仅使用full模式）。详细配置教程请查阅文档",
                "templates" : {
                    "default" : {
                        "name" : "跳过配置项",
                        "hint" : "描述类型消息需要跳过审核",
                        "items" : {
                            "match_type" : {
                                "description" : "匹配类型",
                                "type" : "string",
                                "options" : ["full","prefix","suffix","regex"],
                                "default" : "full"
                            },
                            "match_content" : {
                                "description" : "匹配内容",
                                "type" : "text",
                                "hint" : "根据上述类型填写，如果类型为regex这里的内容必须是python的re模块可编译的正则表达式"
                            }
                        }
                    }
                }
            }
        }
    },
    "speak_config" : {
        "description" : "违规回复模型（第二个llm）相关配置",
        "type" : "object",
        "items" : {
            "enable_speak" : {
                "description" : "是否开启第二个llm",
                "hint" : "开启后，遇到违规消息会使用llm生成回复；否则直接使用「违规消息回复失败通用回复」作为回复内容。关闭前请确保已填写通用回复，否则用户将收到空白消息",
                "type" : "bool",
                "default" : true
            },
            "speak_prompt" : {
                "description" : "违禁对话人设",
                "hint" : "如果发现消息违禁，将会使用这个人设进行回复",
                "type" : "string",
                "_special" : "select_persona"
            },
            "speak_provider" : {
                "description" : "违禁对话提供商",
                "hint" : "违禁消息会交由这个模型处理",
                "type" : "string",
                "_special" : "select_provider"
            },
            "speak_start" : {
                "description" : "违禁消息回复前缀",
                "hint" : "可以给你的违禁消息回复加上一个前缀",
                "type" : "text"
            },
            "speak_end" : {
                "description" : "违禁消息回复后缀",
                "hint" : "可以给你的违禁消息回复加上一个后缀",
                "type" : "text"
            },
            "speak_fallback" : {
                "description" : "违规消息回复失败通用回复",
                "hint" : "如果以上选择的违规对话提供商返回失败，会直接使用这个消息回复，这条消息会带上前后缀",
                "type" : "text"
            }
        }
    },
    "platform_config" : {
        "description" : "平台与用户配置",
        "type" : "object",
        "items" : {
            "available_platforms" : {
                "description" : "可用消息平台",
                "hint" : "你现在拥有的消息平台名称（例如aiocqhttp）",
                "type" : "list"
            },
            "white_list" : {
                "description" : "白名单设置",
                "hint" : "审核插件会跳过的用户设置，对于每个白名单项需要同时填写消息平台和用户id",
                "type" : "template_list",
                "templates" : {
                    "white_list_temp" : {
                        "name" : "用户白名单项",
                        "items" : {
                            "platform" : {
                                "description" : "用户消息平台名称",
                                "type" : "string"
                            },
                            "user_id" : {
                                "description" : "用户id",
                                "type" : "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "notify_config" : {
        "description" : "违规消息通知相关配置",
        "type" : "object",
        "items" : {
            "enable_notify" : {
                "description" : "是否开启违规通知",
                "hint" : "开启后，检测到违规消息时会立即通知管理员。管理员需在配置中添加会话umo才能接收通知",
                "type" : "bool",
                "default" : false
            },
            "notify_umo" : {
                "description" : "接受提醒事件的会话umo",
                "hint" : "考虑到各个平台和实际需求，本插件仅开放单一会话接受违规消息，umo可以在会话中输入命令/sid查看",
                "type" : "string"
            },
            "notify_retry_intrvael" : {
                "description" : "通知重试间隔（秒）",
                "hint" : "通知发送失败后，定期重试的时间间隔，默认60秒",
                "type" : "int",
                "default" : 60
            },
            "notify_max_retries" : {
                "description" : "通知最大重试次数",
                "hint" : "单条通知最多重试次数，超过后将丢弃，默认3次",
                "type" : "int",
                "default" : 3
            }
        }
    },
    "command_config" : {
        "description" : "指令相关可选配置",
        "type" : "object",
        "items" : {
            "check_show_ban" : {
                "description" : "是否在使用check命令时展示已被封禁的用户",
                "hint" : "如果关闭，check命令展示的所有用户均不处于封禁状态",
                "type" : "bool",
                "default" : true
            },
            "check_disshow_time" : {
                "description" : "违规消息出现后不在check命令中显示的时间（天）",
                "hint" : "经过这段时间未处理的违规消息不会在check命令中显示（相关消息不会被删除），可以使用checku命令查看（请设置为大于0的整数否则插件会报错）",
                "type" : "int",
                "default" : 3
            }
        }
    }
}